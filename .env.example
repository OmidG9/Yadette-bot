# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://yadette:yadette@localhost:5432/yadette?schema=public"

# Separate database used ONLY by `pnpm test:integration`. It must never be the
# same database as DATABASE_URL: the integration suite truncates every table
# between cases, and the run aborts if the two names match.
# Create it once:  createdb -U yadette yadette_test
TEST_DATABASE_URL="postgresql://yadette:yadette@localhost:5432/yadette_test?schema=public"

# --- Application ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LANGUAGE=fa

# How often the birthday reminder job checks for due notifications (ms)
REMINDER_CHECK_INTERVAL_MS=60000

# --- Feature flags ----------------------------------------------------------
# A flag is read where the UI is built, so a disabled feature disappears from the
# interface entirely rather than leaving a button that errors when tapped. They
# never gate business rules: turning one off cannot corrupt stored data.
#
# Accepted values: true/false, 1/0, yes/no, on/off (case-insensitive). Leaving a
# variable out, or writing a value that cannot be read, uses the default below.
# A false value is the safe choice while a feature is being rolled out.
#
# Phase 1 - shipped, on by default:
DASHBOARD_ENABLED=true
SEARCH_ENABLED=true
CALENDAR_ENABLED=true
SNOOZE_ENABLED=true
HEALTHCHECK_ENABLED=true

# Phase 2 - declared but off. There is no UI behind these yet; switching one on
# today would expose an empty screen.
GIFTS_ENABLED=false
GROUPS_ENABLED=false
AI_ENABLED=false
