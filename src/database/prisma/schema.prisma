// Yadette — database schema
// Modular monolith: every query is scoped by userId to prevent cross-user access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  /// Telegram user id, stored as string to avoid BigInt/JSON pitfalls.
  telegramId      String   @unique
  username        String?
  firstName       String?
  lastName        String?
  timezone        String
  language        String
  reminderEnabled Boolean  @default(true)
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  people           Person[]
  reminders        Reminder[]
  notificationLogs NotificationLog[]
  snoozes          Snooze[]
  flowStates       UserFlowState[]

  @@index([createdAt])
}

/// A person whose yearly birthday the user wants to remember.
model Person {
  id     String @id @default(cuid())
  userId String
  name   String
  /// Birthday recurrence rule in the Jalali (Persian) calendar.
  /// Yearly occurrences are derived from month/day — never from a single date.
  birthMonth Int
  birthDay   Int
  /// Original birth year in the Jalali calendar, only when the user provided it.
  birthYear  Int?
  notes      String?
  /// §3.3 - normalized name + notes + interests, kept in sync on every write.
  ///
  /// Search has to compare a folded query against folded stored text: an Arabic
  /// keyboard produces ي/ك where Persian expects ی/ک, and ZWNJ comes and goes.
  /// Normalizing only the query would miss "كتاب" for a person stored as
  /// "کتاب", so both sides are canonicalised on write and matched as one column.
  searchText String @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests        Interest[]
  reminders        Reminder[]
  notificationLogs NotificationLog[]
  snoozes          Snooze[]

  @@index([userId, deletedAt])
  @@index([userId, name])
  @@index([userId, birthMonth, birthDay])
}

/// Simple interest/tag stored for a person (e.g. "گیم", "قهوه").
/// Not an AI recommendation system — plain user-provided information.
model Interest {
  id        String   @id @default(cuid())
  personId  String
  title     String
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, title])
  @@index([personId])
}

/// A per-person reminder offset. Multiple reminders per person are supported.
model Reminder {
  id         String   @id @default(cuid())
  userId     String
  personId   String
  /// Days before the birthday. 0 = on the birthday itself.
  daysBefore Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, daysBefore])
  @@index([userId, enabled])
  @@index([personId, enabled])
}

/// Delivery state for one notification slot.
///
/// The unique constraint is still the race-condition guard for concurrent
/// scheduler runs, but a row now means "this slot is being handled", not
/// "this slot was delivered". That distinction is what makes a retry possible:
/// a failed send keeps the row as `pending` with a `nextAttemptAt`, instead of
/// deleting it and losing the reminder (§3.6).
model NotificationLog {
  id           String @id @default(cuid())
  userId       String
  personId     String
  /// Jalali year of the birthday occurrence this notification belongs to.
  birthdayYear Int
  daysBefore   Int
  /// `pending` claimed or awaiting retry · `sent` delivered · `failed` gave up.
  status       String   @default("pending")
  /// How many delivery attempts have been made, including the current one.
  attempts     Int      @default(1)
  /// When the retry pass may pick this row up again.
  nextAttemptAt DateTime @default(now())
  /// Last failure, truncated. Diagnostics only — never shown as a user message.
  lastError    String?
  /// Set when `status` becomes `sent`.
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId, birthdayYear, daysBefore])
  @@index([userId, sentAt])
  @@index([personId, birthdayYear])
  /// Drives the retry pass: pending rows whose backoff has elapsed.
  @@index([status, nextAttemptAt])
}

/// §3.5 — a reminder the user postponed from the notification keyboard.
///
/// Created when the user taps «⏰ یادآوری دوباره». The original notification
/// slot is released, so this row — not the log — is what the delivery job
/// consumes for the postponed message.
model Snooze {
  id            String   @id @default(cuid())
  userId        String
  personId      String
  /// The occurrence and offset of the notification being postponed.
  birthdayYear  Int
  daysBefore    Int
  /// Earliest moment the postponed notification may be delivered.
  deliverAt     DateTime
  /// `pending` waiting or retrying · `sent` delivered · `failed` gave up.
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// One snooze per notification slot: re-snoozing updates the existing row.
  @@unique([userId, personId, birthdayYear, daysBefore])
  @@index([status, nextAttemptAt])
  @@index([userId, status])
}

/// Conversation state for multi-step Telegram flows.
/// Persisted in PostgreSQL (not process memory) so a restart does not trap the user.
/// The store interface is intentionally narrow so it can be swapped for Redis later.
model UserFlowState {
  userId    String   @id
  flow      String
  step      String
  data      Json     @default("{}")
  /// Telegram message id of the last prompt, so prompts can be edited in place.
  messageId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}
